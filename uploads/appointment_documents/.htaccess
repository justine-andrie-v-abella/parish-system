# Uploaded documents (birth certificates, IDs, etc.) must only be reachable
# through ajax/view-appointment-document.php, which checks ownership/role
# before streaming a file. Never serve this directory directly.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
